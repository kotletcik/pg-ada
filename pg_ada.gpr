with "config/pg_ada_config.gpr";
project Pg_Ada is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Pg_Ada_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("main.adb");

   package Compiler is
      for Default_Switches ("Ada") use Pg_Ada_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

   package Builder is
   for Executable ("main.adb") use "main1";
end Builder;

end Pg_Ada;
